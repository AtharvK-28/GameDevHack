; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ghosted Movers"
run/main_scene="res://menus/opening/opening.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Balance="*res://autoload/Balance.gd"
Net="*res://autoload/Net.gd"
PageServer="*res://autoload/PageServer.gd"
InputRouter="*res://core/InputRouter.gd"
Sfx="*res://autoload/Sfx.gd"
Game="*res://autoload/Game.gd"
SceneLoader="*res://addons/maaacks_scene_loader/base/nodes/autoloads/scene_loader/scene_loader.tscn"
ProjectUISoundController="*res://menus/ui_sound_controller.tscn"
UiMotion="*res://autoload/UiMotion.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/maaacks_game_template/plugin.cfg", "res://addons/maaacks_scene_loader/plugin.cfg", "res://addons/maaacks_ui_sound_controller/plugin.cfg")

[filesystem]

import/blender/enabled=false

[maaacks_game_template]

copy_path="res://menus/"
disable_install_wizard=true
disable_install_audio_busses=true
main_menu_scene_path="res://menus/main_menu/main_menu.tscn"
game_scene_path="res://Main.tscn"
ending_scene_path=""

[maaacks_scene_loader]

loading_scene_path="res://menus/loading_screens/loading_screen.tscn"

[maaacks_ui_sound_controller]

disable_install_audio_busses=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
lights_and_shadows/directional_shadow/size=2048
